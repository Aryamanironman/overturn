 "sentences": [
  {
   "text": "Your insurer said no.",
   "start": 0,
   "end": 1.241
  },
  {
   "text": "Four reasons.",
   "start": 1.491,
   "end": 2.321
  },
  {
   "text": "Three of them are wrong.",
   "start": 2.57,
   "end": 3.703
  },
  {
   "text": "Most people can't prove what the file already says.",
   "start": 3.953,
   "end": 6.557
  },
  {
   "text": "OVERTURN can.",
   "start": 6.807,
   "end": 7.75
  },
  {
   "text": "It reads the denial, the policy, the clinical record, and the codes.",
   "start": 8,
   "end": 11.777
  },
  {
   "text": "It finds the contradiction.",
   "start": 12.027,
   "end": 13.423
  },
  {
   "text": "It re-queries the source.",
   "start": 13.672,
   "end": 14.918
  },
  {
   "text": "It shows its work.",
   "start": 15.168,
   "end": 16.182
  },
  {
   "text": "No dashboard.",
   "start": 16.432,
   "end": 17.366
  },
  {
   "text": "No score without a citation.",
   "start": 17.616,
   "end": 19.309
  },
  {
   "text": "Every claim resolves to a row.",
   "start": 19.559,
   "end": 21.216
  },
  {
   "text": "Seven sources, one data path: Zetaris.",
   "start": 21.466,
   "end": 24.231
  },
  {
   "text": "Five agents: plan, reconcile, attack, defend, report.",
   "start": 24.481,
   "end": 28.026
  },
  {
   "text": "A deterministic score.",
   "start": 28.276,
   "end": 29.56
  },
  {
   "text": "A tamper-evident ledger.",
   "start": 29.81,
   "end": 31.21
  },
  {
   "text": "A human reviews it.",
   "start": 31.459,
   "end": 32.643
  },
  {
   "text": "A human signs it.",
   "start": 32.894,
   "end": 34.004
  },
  {
   "text": "OVERTURN does the reading.",
   "start": 34.253,
   "end": 35.61
  },
  {
   "text": "And the one document that's missing?",
   "start": 35.86,
   "end": 37.572
  },
  {
   "text": "It won't invent it.",
   "start": 37.822,
   "end": 38.83
  },
  {
   "text": "It tells you to get it.",
   "start": 39.081,
   "end": 40.246
  },
  {
   "text": "Eighty-four out of one hundred.",
   "start": 40.496,
   "end": 41.998
  },
  {
   "text": "Solid.",
   "start": 42.248,
   "end": 42.833
  },
  {
   "text": "Conditional.",
   "start": 43.083,
   "end": 43.827
  },
  {
   "text": "Send the letter, and it's one hundred.",
   "start": 44.077,
   "end": 45.848
  },
  {
   "text": "One worker.",
   "start": 46.098,
   "end": 46.899
  },
  {
   "text": "One denial.",
   "start": 47.149,
   "end": 47.959
  },
  {
   "text": "One document a human can send.",
   "start": 48.209,
   "end": 50.284
  },
  {
   "text": "Built with Zetaris, Meterless, and NVIDIA Nemotron.",
   "start": 50.534,
   "end": 53.662
  },
  {
   "text": "OVERTURN.",
   "start": 53.912,
   "end": 54.655
  },
  {
   "text": "The denial, answered with evidence.",
   "start": 54.905,
   "end": 56.865
  }
 ],
