# OVERTURN configuration. Copy to .env and fill real values.
# Never commit .env. Every value below is a placeholder.

# auto = live when Zetaris + Nightshift are configured, otherwise offline sample mode.
SAMPLE_MODE=auto

# Zetaris (the only data path). Local UI-proxy install:
ZETARIS_REST_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_SQL_PATH=/api/proxy/sql-editor/sqls/run-query
ZETARIS_QUERY_LIMIT=1000

# Legacy REST install example:
# ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# ZETARIS_SQL_PATH=/sql-editor/sqls/run

# Meterless Nightshift (OpenAI-compatible). Copy URL + Runtime token from the Console.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_APP=overturn
METERLESS_SCOPE=user
METERLESS_MODEL=meterless/auto

# Pin the hardest reasoning lane. Use the exact model id from Nightshift's model picker.
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
MODEL_PLANNER=
MODEL_RECONCILER=
MODEL_CRITIC=
MODEL_ADVOCATE=
MODEL_REPORTER=

# Meterless engines (optional in sample mode)
HMEM_URL=
HMEM_API_KEY=
WORLD_MODEL_URL=
WORLD_MODEL_API_KEY=

# Local H-MEM store in sample mode
OVERTURN_HMEM_PATH=
